            </setting>
            <setting name="Import_PO_SysproSetupService_setupclass" serializeAs="String">
                <value>https://stock2shop.aussietraveller.com.au/SYSPROWebServices/setup.asmx</value>
            </setting>
        </Import_PO.My.MySettings>
    </applicationSettings>
